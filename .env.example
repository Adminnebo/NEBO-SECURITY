# Copy to .env for local development. Never commit .env or real credentials.
NODE_ENV=development
PORT=3000
TRUST_PROXY=none
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://nebo:REPLACE_PASSWORD@127.0.0.1:5432/nebo_security
# Generate a valid JSON value with: npm run admin:config
NEBO_BOOTSTRAP_ADMIN_JSON='{"username":"admin","displayName":"Administrador","passwordHash":"REPLACE_WITH_GENERATED_SCRYPT_HASH"}'
# Railway: set NODE_ENV=production and APP_ORIGIN=https://your-domain.example.
# If APP_ORIGIN is absent, the server can use RAILWAY_PUBLIC_DOMAIN.
# PORT is supplied automatically by Railway. DATABASE_URL must reference Postgres.
# Railway edge only: TRUST_PROXY=railway uses its X-Real-IP for login rate limits.
